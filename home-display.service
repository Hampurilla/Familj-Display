[Unit]
Description=Familj Display local dashboard
After=network.target home-display-update.service
Wants=home-display-update.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/home-display
ExecStart=/home/admin/home-display/venv/bin/python /home/admin/home-display/app.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
UMask=0077
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
